{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run Pipeline Combat Demo",
			"type": "shell",
			"command": "uv",
			"args": [
				"run",
				"python",
				"examples/demo.py"
			],
			"group": "build",
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "PEP 8: Format Entire Codebase",
			"type": "shell",
			"command": "./scripts/format_code.sh",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": "build",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared",
				"showReuseMessage": true,
				"clear": false
			},
			"problemMatcher": []
		},
		{
			"label": "PEP 8: Format Current File",
			"type": "shell",
			"command": "./scripts/format_file_comprehensive.sh",
			"args": [
				"${file}"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": "build",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared",
				"showReuseMessage": true,
				"clear": false
			},
			"problemMatcher": []
		},
		{
			"label": "PEP 8: Quick Lint Check",
			"type": "shell",
			"command": "./scripts/lint_check.sh",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": "test",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared",
				"showReuseMessage": true,
				"clear": false
			},
			"problemMatcher": {
				"owner": "ruff",
				"fileLocation": "relative",
				"pattern": {
					"regexp": "^(.+):(\\d+):(\\d+):\\s+(\\w+)\\s+(.+)$",
					"file": 1,
					"line": 2,
					"column": 3,
					"severity": 4,
					"message": 5
				}
			}
		},
		{
			"label": "PEP 8: Validate Configuration",
			"type": "shell",
			"command": "./scripts/validate_pep8_config.sh",
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": "test",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared",
				"showReuseMessage": true,
				"clear": false
			},
			"problemMatcher": []
		},
		{
			"label": "Generate API Documentation",
			"type": "shell",
			"command": "./scripts/generate_docs.sh",
			"group": "build",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared",
				"showReuseMessage": true,
				"clear": false
			},
			"problemMatcher": []
		},
		{
			"label": "Run Tests with Coverage",
			"type": "shell",
			"command": "uv",
			"args": [
				"run",
				"pytest",
				"--cov=src/pipelinecombat",
				"--cov-report=term-missing",
				"--cov-report=html"
			],
			"group": "test",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared",
				"showReuseMessage": true,
				"clear": false
			},
			"problemMatcher": {
				"owner": "pytest",
				"fileLocation": "relative",
				"pattern": {
					"regexp": "^(.+):(\\d+):\\s*(.*?)\\s*FAILED",
					"file": 1,
					"line": 2,
					"message": 3
				}
			}
		}
	]
}
